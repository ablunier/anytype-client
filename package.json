{
  "name": "@ablunier/anytype-client",
  "version": "0.1.0",
  "description": "A typed TypeScript client for the Anytype desktop app's local API (v2)",
  "license": "MIT",
  "author": {
    "name": "Adrian P. Blunier",
    "email": "adrianp@blunier.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ablunier/anytype-client.git"
  },
  "homepage": "https://github.com/ablunier/anytype-client#readme",
  "bugs": "https://github.com/ablunier/anytype-client/issues",
  "keywords": [
    "anytype",
    "api",
    "client",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
